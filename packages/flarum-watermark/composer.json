{
  "name": "annonny/flarum-watermark",
  "description": " watermarks for your forum",
  "keywords": [
    "flarum"
  ],
  "type": "flarum-extension",
  "license": "MIT",
  "require": {
    "flarum/core": "^1.2.0"
  },
  "authors": [
    {
        "name": "Annonny"
    }
  ],
  "autoload": {
