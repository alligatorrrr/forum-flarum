{
    "name": "ziiven/flarum-dice-game",
    "description": "A Flarum extension.",
    "type": "flarum-extension",
    "license": "MIT",
    "require": {
        "flarum/core": "^1.8.1",
        "antoinefr/flarum-ext-money": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Ziven\\DiceGame\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Ziven"
        }
    ],
    "extra": {
        "flarum-extension": {
            "title": "Ziven Dice Game",
            "icon": {
                "name": "fas fa-dice",
                "backgroundColor": "#fbbc04",
                "color": "#fff"
            }
        }
    }
}